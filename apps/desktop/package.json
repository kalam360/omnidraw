{
  "name": "omnidraw-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:storage && pnpm test:canvas && pnpm test:agent",
    "test:storage": "vitest run --config vitest.storage.config.ts",
    "test:storage:watch": "vitest --config vitest.storage.config.ts",
    "test:canvas": "vitest run --config ./vitest.canvas.config.ts",
    "test:canvas:watch": "vitest --config ./vitest.canvas.config.ts",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "test:frontend": "playwright test",
    "test:frontend:install": "playwright install chromium"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.63",
    "@assistant-ui/react": "^0.7.0",
    "@assistant-ui/react-ai-sdk": "1.3.23",
    "@assistant-ui/react-markdown": "^0.7.0",
    "@base-ui/react": "1.4.1",
    "@earendil-works/pi-agent-core": "0.74.0",
    "@earendil-works/pi-ai": "0.74.0",
    "@excalidraw/element": "workspace:*",
    "@excalidraw/excalidraw": "workspace:*",
    "@fontsource-variable/geist": "5.2.8",
    "ai": "6.0.177",
    "better-sqlite3": "11.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "1.1.1",
    "lucide-react": "1.14.0",
    "morphdom": "2.7.4",
    "radix-ui": "1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.3",
    "remark-gfm": "4.0.1",
    "shadcn": "4.7.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.11",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "7.6.12",
    "@types/morphdom": "2.4.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "22.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
